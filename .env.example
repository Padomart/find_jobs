# Скопируйте в .env и заполните. .env не коммитится (см. .gitignore).
# Загрузка в текущий shell: set -a; source .env; set +a

# JobSync MCP: адрес (с /api/mcp или без) и токен из Settings -> MCP Access
JOBSYNC_URL=
JOBSYNC_TOKEN=

# ru: AI-оценка вакансий (--ai)
DEEPSEEK_API_KEY=

# ru: SuperJob, ключ приложения
SUPERJOB_KEY=
